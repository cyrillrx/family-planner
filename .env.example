# Copy to .env and fill in. Never commit .env.
# Consumed by the scripts in telegram-bot/.

# Firebase service account credentials (Firestore access)
FIRESTORE_TOKEN=

# Telegram bot token, obtained from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram group chat ID the bot posts to
TELEGRAM_CHAT_ID=

# Anthropic API key, used to generate the notification content
ANTHROPIC_API_KEY=
