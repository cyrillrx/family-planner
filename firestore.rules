rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Closed by default, which is what the database was created as. Every collection opens
    // explicitly, in the change that introduces it, so one added later is never reachable by
    // accident. See ADR-003: authorization is expressed as rules, not as logic.
    match /{document=**} {
      allow read, write: if false;
    }

    // Addressed by the credential that authenticates it, so a device reaches its own user and no other.
    match /users/{credential} {
      allow read: if isSignedInAs(credential);
      allow create: if isSignedInAs(credential) && isValidUser(credential);
      // The identifier is the member's identity in every group: renaming keeps it.
      allow update: if isSignedInAs(credential)
        && isValidUser(credential)
        && request.resource.data.id == resource.data.id;
    }

    // A group is reached through a membership addressed by the credential reading it (ADR-008).
    match /groups/{groupId} {
      allow read: if isMemberOf(groupId);
      // Only alongside its founder's membership, written in the same batch.
      allow create: if request.auth != null
        && isValidGroup(groupId)
        && existsAfter(membership(groupId, request.auth.uid));

      match /members/{credential} {
        allow read: if isMemberOf(groupId);
        // The founder's, alongside a group that did not exist before the batch.
        allow create: if isSignedInAs(credential)
          && isValidMembership(groupId, credential)
          && !exists(group(groupId))
          && existsAfter(group(groupId));
      }
    }

    // Lets a device find its own memberships, whatever their group.
    match /{path=**}/members/{credential} {
      allow read: if request.auth != null && resource.data.credential == request.auth.uid;
    }

    function group(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function membership(groupId, credential) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(credential);
    }

    function isMemberOf(groupId) {
      return request.auth != null && exists(membership(groupId, request.auth.uid));
    }

    function isValidGroup(groupId) {
      let group = request.resource.data;
      return group.keys().hasOnly(['id', 'name', 'createdAt'])
        && group.id == groupId
        && group.name is string && group.name.trim().size() > 0
        && group.createdAt == request.time;
    }

    // The UserId is attribution, read from the member's own user document; access never reads it.
    function isValidMembership(groupId, credential) {
      let member = request.resource.data;
      return member.keys().hasOnly(['userId', 'groupId', 'credential', 'joinedAt'])
        && member.groupId == groupId
        && member.credential == credential
        && member.joinedAt == request.time
        && member.userId == get(/databases/$(database)/documents/users/$(credential)).data.id;
    }

    function isSignedInAs(credential) {
      return request.auth != null && request.auth.uid == credential;
    }

    function isValidUser(credential) {
      let user = request.resource.data;
      return user.keys().hasOnly(['id', 'displayName', 'authenticatedId'])
        // TODO(#68): nothing keeps a device from claiming another member's identifier.
        && user.id is string && user.id.size() > 0
        // TODO(#70): no upper bound, here or in the client.
        && user.displayName is string && user.displayName.trim().size() > 0
        && user.authenticatedId == credential;
    }
  }
}
