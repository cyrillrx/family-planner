rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Closed by default, which is what the database was created as. Every collection opens
    // explicitly, in the change that introduces it, so one added later is never reachable by
    // accident. See ADR-003: authorization is expressed as rules, not as logic.
    match /{document=**} {
      allow read, write: if false;
    }

    // Addressed by the credential that authenticates it, so a device reaches its own user and no
    // other. Members reading each other's names open this further with the group.
    match /users/{credential} {
      allow read: if isSignedInAs(credential);
      allow create: if isSignedInAs(credential) && isValidUser(credential);
      // The identifier is the member's identity in every group: renaming keeps it.
      allow update: if isSignedInAs(credential)
        && isValidUser(credential)
        && request.resource.data.id == resource.data.id;
    }

    function isSignedInAs(credential) {
      return request.auth != null && request.auth.uid == credential;
    }

    function isValidUser(credential) {
      let user = request.resource.data;
      return user.keys().hasOnly(['id', 'displayName', 'authenticatedId'])
        // TODO(#68): nothing keeps a device from claiming another member's identifier.
        && user.id is string && user.id.size() > 0
        // TODO(#70): no upper bound, here or in the client.
        && user.displayName is string && user.displayName.trim().size() > 0
        && user.authenticatedId == credential;
    }
  }
}
